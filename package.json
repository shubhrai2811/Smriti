{
  "name": "smriti",
  "version": "0.1.0",
  "description": "Intelligent memory system for AI coding assistants",
  "type": "module",
  "exports": {
    ".": "./src/services/worker-service.ts",
    "./opencode": "./plugin/opencode/smriti-plugin.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run src/services/worker-service.ts --daemon",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "latest",
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "hono": "^4.7.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sqlite-vec": "^0.1.7-alpha.2"
  }
}
